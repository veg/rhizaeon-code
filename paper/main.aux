\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces \textbf  {Scenario 1.4: Bacterial Micro-Conversion and Scale-Space Resolution Benchmark.} Performance of \texttt  {RhizAeon}\xspace  versus 3SEQ across 900 authentic simulation trials ($L = 5{,}000\text  { nt}$, 20 replicates across 45 parameter regimes) spanning micro-conversion tract lengths $L_{\text  {tract}} \in \{50, 100, 200, 400, 800\}$ nt ($1.0\%\text  {--}16.0\%$ of genome length). Each tract length is evaluated across three parental divergences ($d_{\text  {parent}} \in \{0.02, 0.05, 0.10\}$) and three descendant recombinant swarm sizes ($K \in \{2, 5, 10\}$ isolates) with 30 non-recombinant background parental taxa (15 in $P_1$, 15 in $P_2$; total $N \in \{32, 35, 40\}$). Ground truth consists of $K_{\text  {true}} = 1.0$ ancestral micro-conversion event. Columns report parental divergence ($d_{\text  {parent}}$), descendant isolates ($K$), cohort size ($N$), expected mutations in tract (Mut), and for each engine: inferred unique events ($\hat  {K}$), member isolate recall (\%), background parental false positive rate ($\text  {FPR}_{\text  {parent}}$, \%), spatial Jaccard overlap ($J$), and execution runtime in milliseconds (ms).\relax }}{19}{table.caption.11}\protected@file@percent }
\newlabel{tab:micro_conversion_benchmark}{{6}{19}{\textbf {Scenario 1.4: Bacterial Micro-Conversion and Scale-Space Resolution Benchmark.} Performance of \RhizAeon versus 3SEQ across 900 authentic simulation trials ($L = 5{,}000\text { nt}$, 20 replicates across 45 parameter regimes) spanning micro-conversion tract lengths $L_{\text {tract}} \in \{50, 100, 200, 400, 800\}$ nt ($1.0\%\text {--}16.0\%$ of genome length). Each tract length is evaluated across three parental divergences ($d_{\text {parent}} \in \{0.02, 0.05, 0.10\}$) and three descendant recombinant swarm sizes ($K \in \{2, 5, 10\}$ isolates) with 30 non-recombinant background parental taxa (15 in $P_1$, 15 in $P_2$; total $N \in \{32, 35, 40\}$). Ground truth consists of $K_{\text {true}} = 1.0$ ancestral micro-conversion event. Columns report parental divergence ($d_{\text {parent}}$), descendant isolates ($K$), cohort size ($N$), expected mutations in tract (Mut), and for each engine: inferred unique events ($\hat {K}$), member isolate recall (\%), background parental false positive rate ($\text {FPR}_{\text {parent}}$, \%), spatial Jaccard overlap ($J$), and execution runtime in milliseconds (ms).\relax }{table.caption.11}{}}
