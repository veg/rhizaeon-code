\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Paired replication benchmark of the Posada and Crandall (2001) simulation suite evaluating \texttt  {RhizAeon}\xspace  versus 3SEQ across 32 experimental conditions (100 replicates each, 3,200 trials per engine, 6,400 runs total). Simulations I evaluate detection power and structural reticulation fidelity across population mutation rates ($\theta $) and recombination rates ($\rho $) under uniform rates ($\alpha = \text  {None}$). Simulations II evaluate false positive rate control under strict clonal nulls ($\rho = 0.0$) with continuous Gamma site-rate heterogeneity ($\alpha \in \{2.0, 0.5, 0.05\}$). Evaluated columns report ground-truth reticulations ($K_{\text  {true}}$), detection rate (Power or FPR, \%), inferred reticulation count ($\hat  {K}$), Reticulation Precision ($\text  {PPV}_{\mathcal  {R}}$), Triad Fidelity ($S_{\text  {triad}}$), Informative SNP Jaccard ($J_{\text  {SNP}}$), and execution runtime (ms).\relax }}{13}{table.caption.7}\protected@file@percent }
\newlabel{tab:posada_crandall_results}{{2}{13}{Paired replication benchmark of the Posada and Crandall (2001) simulation suite evaluating \RhizAeon versus 3SEQ across 32 experimental conditions (100 replicates each, 3,200 trials per engine, 6,400 runs total). Simulations I evaluate detection power and structural reticulation fidelity across population mutation rates ($\theta $) and recombination rates ($\rho $) under uniform rates ($\alpha = \text {None}$). Simulations II evaluate false positive rate control under strict clonal nulls ($\rho = 0.0$) with continuous Gamma site-rate heterogeneity ($\alpha \in \{2.0, 0.5, 0.05\}$). Evaluated columns report ground-truth reticulations ($K_{\text {true}}$), detection rate (Power or FPR, \%), inferred reticulation count ($\hat {K}$), Reticulation Precision ($\text {PPV}_{\mathcal {R}}$), Triad Fidelity ($S_{\text {triad}}$), Informative SNP Jaccard ($J_{\text {SNP}}$), and execution runtime (ms).\relax }{table.caption.7}{}}
