\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces \textbf  {Scenario 1.2: Multi-way mosaic swarms benchmark.} Performance of \texttt  {RhizAeon}\xspace  versus 3SEQ across 540 simulation trials ($N = 46\text  {--}55$ taxa, $L = 6,000$ nt, 20 replicates per condition) evaluating three complex multi-parental topologies: Dual-Cassette ($P_1 \to P_2 \to P_1 \to P_3 \to P_1$), Nested Russian Doll ($P_1 \to P_2 \to P_3 \to P_2 \to P_1$), and Triple Crossover Cascade ($P_1 \to P_2 \to P_3$). Ground truth consists of $K_{\text  {true}} = 2.0$ parental transitions across $K \in \{1, 5, 10\}$ expanding descendant isolates and 45 non-recombinant background taxa (15 per clade). $\hat  {K}_{\text  {unique}}$ is the number of inferred unique events; $\text  {FPR}_{\text  {parent}}$ is the false positive rate on the 45 non-recombinant background taxa; Recall and Precision measure isolate attribution fidelity; Jaccard measures spatial tract boundary overlap; Runtime is wall-clock execution time in milliseconds per alignment.\relax }}{16}{table.caption.9}\protected@file@percent }
\newlabel{tab:multiway_mosaic_benchmark}{{4}{16}{\textbf {Scenario 1.2: Multi-way mosaic swarms benchmark.} Performance of \RhizAeon versus 3SEQ across 540 simulation trials ($N = 46\text {--}55$ taxa, $L = 6,000$ nt, 20 replicates per condition) evaluating three complex multi-parental topologies: Dual-Cassette ($P_1 \to P_2 \to P_1 \to P_3 \to P_1$), Nested Russian Doll ($P_1 \to P_2 \to P_3 \to P_2 \to P_1$), and Triple Crossover Cascade ($P_1 \to P_2 \to P_3$). Ground truth consists of $K_{\text {true}} = 2.0$ parental transitions across $K \in \{1, 5, 10\}$ expanding descendant isolates and 45 non-recombinant background taxa (15 per clade). $\hat {K}_{\text {unique}}$ is the number of inferred unique events; $\text {FPR}_{\text {parent}}$ is the false positive rate on the 45 non-recombinant background taxa; Recall and Precision measure isolate attribution fidelity; Jaccard measures spatial tract boundary overlap; Runtime is wall-clock execution time in milliseconds per alignment.\relax }{table.caption.9}{}}
