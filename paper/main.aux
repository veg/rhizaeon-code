\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Epidemic Clonal Expansion benchmark evaluating \texttt  {RhizAeon}\xspace  versus 3SEQ across 15 experimental conditions (20 replicates each, 300 alignments total, $L = 5,000\text  { nt}$). A single ancestral recombination event ($K_{\text  {true}} = 1.00$, tract $[1500, 3000]$) expands into $K$ descendant isolates with transmission drift ($\bar  {d} = 0.002$), alongside $N_{P1} = 20$ and $N_{P2} = 20$ background parental isolates. Columns report parental divergence ($d_{\text  {parent}}$), cohort size ($K$), and total taxa ($N$). Performance metrics include inferred unique events ($\hat  {K}_{\text  {unique}}$), background parental false positive rate ($\text  {FPR}_{\text  {parent}}$), member recall, precision, Informative Jaccard index ($J$), and execution runtime in milliseconds.\relax }}{14}{table.caption.8}\protected@file@percent }
\newlabel{tab:epidemic_expansion_results}{{3}{14}{Epidemic Clonal Expansion benchmark evaluating \RhizAeon versus 3SEQ across 15 experimental conditions (20 replicates each, 300 alignments total, $L = 5,000\text { nt}$). A single ancestral recombination event ($K_{\text {true}} = 1.00$, tract $[1500, 3000]$) expands into $K$ descendant isolates with transmission drift ($\bar {d} = 0.002$), alongside $N_{P1} = 20$ and $N_{P2} = 20$ background parental isolates. Columns report parental divergence ($d_{\text {parent}}$), cohort size ($K$), and total taxa ($N$). Performance metrics include inferred unique events ($\hat {K}_{\text {unique}}$), background parental false positive rate ($\text {FPR}_{\text {parent}}$), member recall, precision, Informative Jaccard index ($J$), and execution runtime in milliseconds.\relax }{table.caption.8}{}}
